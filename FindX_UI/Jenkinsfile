pipeline {
    agent any
    tools { nodejs 'NodeJS-20' }

    stages {
        // No Checkout stage needed — SCM already pulled the code

        stage('Install Dependencies') {
            steps {
                dir('FindX_UI') {
                    sh 'npm ci'
                }
            }
        }

        stage('Build') {
            steps {
                dir('FindX_UI') {
                    sh 'npm run build'
                }
            }
        }

        stage('Deploy / Run') {
            steps {
                dir('FindX_UI') {
                    sh '''
                        rm -rf /var/www/findx_ui/*
                        cp -r build/* /var/www/findx_ui/
                    '''
                }
            }
        }
    }

    post {
        success { echo 'Build and deploy succeeded ✅' }
        failure { echo 'Build failed ❌' }
    }
}